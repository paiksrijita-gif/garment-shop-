# Copy to .env and fill in, then paste the lines into
# Vercel → Project → Settings → Environment Variables.

# The Google Sheet's ID or full link. Share the sheet as "Anyone with the link — Viewer".
GOOGLE_SHEET_ID=paste-your-google-sheet-id-or-link-here

# Optional: the tab's gid (the number after #gid= in the link) if the data is not on the first tab.
# GOOGLE_SHEET_GID=123456789
